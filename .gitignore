# Secrets - NEVER commit. (This file must stay UTF-8: git cannot read a UTF-16
# .gitignore, which is how a live PAT nearly got committed once.)
.env
.env.*
!.env.example
*.pat
*.token

# Machine-local Claude Code config (plugin install paths, personal permissions)
.claude/settings.local.json

# Project QA context IS committed - the team shares it:
#   .claude/context/active/background.md
#   .claude/context/active/standards.md

# Environment / cache
.venv/
__pycache__/
.pytest_cache/

# Outputs
outputs/
deliverables/
*.log

# QA coverage baselines are COMMITTED - they are the anti-regression record
# (.claude/qa-baselines/<PBI>.json). Do not ignore them.
