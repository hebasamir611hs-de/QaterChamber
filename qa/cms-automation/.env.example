# انسخ لـ .env وعدّل. لا شيء من قيم dev مكتوب داخل الإطار نفسه.
#   Linux/Mac:  set -a && source .env && set +a
#   Windows PS: Get-Content .env | %{ $p=$_.Split('=',2); [Environment]::SetEnvironmentVariable($p[0],$p[1]) }

QC_BASE_URL=https://qcdev.ihorizons.com
QC_USER=test@liferay.com
QC_PASS=

# groupId للموقع "Qatar Chamber". إلزامي — الـ Objects site-scoped.
# بدونه كل قراءة صفوف بترجع 409 (مش 404) وتُقرأ خطأً كـ "لا بيانات".
QC_GROUP_ID=37246
QC_SITE_ERC=QCDEMO-SITE-qatar-chamber
QC_SITE_PATH=/qatar-chamber

QC_DEFAULT_LOCALE=en_US
QC_LOCALES=en_US,ar_SA

# بادئة بيانات التست — أي صف يبدأ بها ملك للـ QA ويُحذف في التنظيف.
QC_TEST_PREFIX=QCTEST-

# انتظار انتشار التغيير. ⚠️ القيم دي مبدئية — شغّل
# tools/propagation-probe.js واضبطها على القياس الحقيقي.
QC_PROPAGATION_TIMEOUT_MS=30000
QC_PROPAGATION_INTERVAL_MS=1500

# سقف pageSize على object-definitions — 99+ يرجع 404 وهمي.
QC_OBJECT_DEFS_PAGE_SIZE=50

# يمنع تعديل أي صف لا يحمل بادئة التست. اتركه شغّالاً على البيئات المشتركة.
QC_STRICT_ISOLATION=true

QC_RUNS_DIR=runs
