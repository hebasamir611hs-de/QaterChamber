  {
   "id": 135272,
   "title": "Verify that a public visitor can view and navigate the Latest News section end to end",
   "state": "Design",
   "priority": 1,
   "tags": [
    "Ai_MCP_Injected",
    "Automation",
    "Functional-High",
    "MEDIA",
    "Regression",
    "UAT",
    "Web"
   ],
   "description": "Functional-High e2e browse+navigate.",
   "area_path": "Qatar Chamber Website Revamp",
   "iteration_path": "Qatar Chamber Website Revamp\\Sprint 1",
   "steps": [
    {
     "action": "Load Home Page as unauthenticated visitor",
     "expected": "Home Page loads"
    },
    {
     "action": "Scroll to Latest News section",
     "expected": "Section renders with tag, heading, and up to the configured number of news cards, newest first"
    },
    {
     "action": "Click a news card",
     "expected": "Browser navigates to that article's full detail page showing matching title/date/image"
    },
    {
     "action": "Navigate back to Home Page",
     "expected": "Home Page reloads with the section intact"
    },
    {
     "action": "Click View All CTA",
     "expected": "Browser redirects to the full News listing page"
    }
   ]
  },
  {
   "id": 135273,
   "title": "Verify that publishing a news article surfaces it in the Latest News section with a success toast",
   "state": "Design",
   "priority": 1,
   "tags": [
