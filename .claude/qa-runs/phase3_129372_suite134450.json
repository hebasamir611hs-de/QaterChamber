   ],
   "description": "Functional-High publish flow.",
   "area_path": "Qatar Chamber Website Revamp",
   "iteration_path": "Qatar Chamber Website Revamp\\Sprint 1",
   "steps": [
    {
     "action": "Log in to Liferay CMS as Site Content Editor",
     "expected": "CMS loads"
    },
    {
     "action": "Navigate to News module > Create Article",
     "expected": "Create Article form displayed"
    },
    {
     "action": "Fill Title EN/AR, category, publication date, thumbnail, body EN/AR",
     "expected": "All fields accept entered values"
    },
    {
     "action": "Save as Draft, Submit for Review, then Publish",
     "expected": "Liferay generic success toast displayed after publish; article status = Published; article appears on Home Page Latest News section, newest first, above older articles"
    }
   ]
  },
