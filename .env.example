# Template — copy to .env (git-ignored) on first clone: cp .env.example .env
# Every value the MCP server and the Phase-1 analysis read. Fill per machine.

# --- Azure DevOps (required) ---
AZURE_PAT=your-azure-devops-personal-access-token
AZURE_ORG_URL=https://dev.azure.com/your-org
AZURE_PROJECT=your-project-name

# --- Phase-1 input sources (optional — leave empty if unused) ---
# Used only when a PBI references a locked source; see CLAUDE.md Core stance.
# FIGMA_API_KEY is the Figma personal access token, read automatically by the
# figma-developer-mcp server (auto-loaded from this .env in the working directory).
# Create one: Figma → Settings → Security → Personal access tokens.
FIGMA_API_KEY=
ATTACHMENTS_TOKEN=

# --- Named CMS role accounts ---
# Eight accounts on qcdev, one shared password (ask the team; never commit it).
# Read via config.settings.cms_role_credentials("<Role>") - never hard-code an
# address or password in a test or Page Object.
# The account decides the lifecycle path: an Author's "Submit for Review" lands
# on Pending Review, an Editor's publishes directly. See standards.md's
# "Named CMS User Roles" and "Content Editorial Workflow" sections.
# QC Site Content Editor
CMS_SITE_CONTENT_EDITOR_EMAIL=
CMS_SITE_CONTENT_EDITOR_PASSWORD=
# QC Site Content Author
CMS_SITE_CONTENT_AUTHOR_EMAIL=
CMS_SITE_CONTENT_AUTHOR_PASSWORD=
# QC Site Content Contributor
CMS_CONTENT_CONTRIBUTOR_EMAIL=
CMS_CONTENT_CONTRIBUTOR_PASSWORD=
# QC Form Manager
CMS_FORM_MANAGER_EMAIL=
CMS_FORM_MANAGER_PASSWORD=
# QC Event Organizer
CMS_EVENT_ORGANIZER_EMAIL=
CMS_EVENT_ORGANIZER_PASSWORD=
# QC SEO Manager
CMS_SEO_MANAGER_EMAIL=
CMS_SEO_MANAGER_PASSWORD=
# QC SEO Editor
CMS_SEO_EDITOR_EMAIL=
CMS_SEO_EDITOR_PASSWORD=
# none - the negative case: signs in, holds no site role
CMS_SITE_MEMBER_EMAIL=
CMS_SITE_MEMBER_PASSWORD=
